@page
@{
    ViewData["Title"] = "Home";
}

<div class="w-screen relative left-1/2 right-1/2 -ml-[50vw] -mr-[50vw]">
    <div class="min-h-screen bg-gradient-to-br from-blue-300 via-green-800 to-brown-200 flex items-center justify-center px-6">

        <div class="backdrop-blur-lg bg-white/10 border border-white/20 rounded-3xl shadow-2xl p-10 max-w-4xl w-full text-center text-white">

            <!-- Title -->
            <h1 class="text-5xl md:text-6xl font-extrabold mb-6 leading-tight animate-fade-in">
                Task Manager
            </h1>

            <!-- Sub-title -->
            <p class="text-lg md:text-xl text-white/80 max-w-2xl mx-auto mb-10 animate-fade-in delay-200">
                Stay organized, focused, and in control.
                A sleek task management experience built with ASP.NET Core.
            </p>

            <!-- CTA -->
            <a href="/TaskItems/Index"
                   class="inline-block px-8 py-4 bg-white text-indigo-600 font-semibold rounded-xl shadow-lg hover:scale-105 hover:shadow-2xl transition duration-300 animate-fade-in delay-300">
                View Your Tasks →
            </a>

            <!-- Divider -->
            <div class="my-10 border-t border-white/20"></div>

            <!-- Features -->
            <div class="grid md:grid-cols-3 gap-6 text-left">

                <div class="bg-white/10 p-6 rounded-xl backdrop-blur-md hover:bg-white/20 transition">
                    <h3 class="text-xl font-semibold mb-2">⚡ Fast</h3>
                    <p class="text-white/70 text-sm">
                        Built with Razor Pages for performance and simplicity.
                    </p>
                </div>

                <div class="bg-white/10 p-6 rounded-xl backdrop-blur-md hover:bg-white/20 transition">
                    <h3 class="text-xl font-semibold mb-2">📋 Organized</h3>
                    <p class="text-white/70 text-sm">
                        Keep track of tasks with a clean and intuitive structure.
                    </p>
                </div>

                <div class="bg-white/10 p-6 rounded-xl backdrop-blur-md hover:bg-white/20 transition">
                    <h3 class="text-xl font-semibold mb-2">🔐 Secure</h3>
                    <p class="text-white/70 text-sm">
                        Powered by ASP.NET Identity for safe authentication.
                    </p>
                </div>

            </div>

        </div>
    </div>
</div>


<!-- Animations Stylesheet -->
<style>
    .animate-fade-in {
        opacity: 0;
        transform: translateY(20px);
        animation: fadeInUp 0.8s ease forwards;
    }

    .animate-fade-in.delay-200 {
        animation-delay: 0.2s;
    }

    .animate-fade-in.delay-300 {
        animation-delay: 0.4s;
    }

    @@keyframes fadeInUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>