@* File: Pages/Shared/_Layout.cshtml *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Task Manager</title>
    <!-- Tailwind CSS via CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 text-gray-800 font-sans">

    <!-- Header with nav links -->
    <header class="bg-white shadow p-6">
        <div class="container mx-auto flex justify-between items-center">
            <!-- Logo/title -->
            <a asp-page="/Index" class="text-2xl font-bold">Task Manager</a>
            <!-- Navigation -->
            <nav class="space-x-4">
                <a asp-page="/Index" class="text-blue-600 hover:underline">Home</a>
                <a asp-page="/TaskItems/Index" class="text-blue-600 hover:underline">Tasks</a>
                <!-- Login/Register or Logout -->
                <partial name="_LoginPartial" />
            </nav>
        </div>
    </header>

    <!-- Main content -->
    <main class="container mx-auto p-6">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-white text-center text-sm p-4 mt-6 shadow-inner">
        &copy; 2025 Task Manager
    </footer>

</body>
</html>
