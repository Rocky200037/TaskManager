@* File: Pages/Shared/_Layout.cshtml *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Task Manager</title>
    <!-- Tailwind CSS via CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 text-gray-800 font-sans">

    <!-- Header with nav links -->
    <header class="bg-gradient-to-r from-blue-400 via-green-700 to-amber-300 shadow-md p-6">
        <div class="container mx-auto flex justify-between items-center">
            <!-- Logo/title -->
            <a asp-page="/Index" class="text-2xl font-bold text-white tracking-wide">
                Task Manager
            </a>

            <!-- Navigation -->
            <nav class="flex items-center gap-4 text-white font-medium">

                <a asp-page="/Index"
                       class="px-4 py-2 bg-blue-500/80 rounded-full hover:bg-blue-400 transition shadow-md">
                    Home
                </a>

                <a asp-page="/TaskItems/Index"
                       class="px-4 py-2 bg-green-500/80 rounded-full hover:bg-green-400 transition shadow-md">
                    Tasks
                </a>

                <!-- Login/Register or Logout -->
                <span class="ml-4">
                    <partial name="_LoginPartial" />
                </span>

            </nav>
        </div>
    </header>

    <!-- Main content -->
    <main class="container mx-auto px-6 pb-6 flex-grow">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-white text-center text-sm p-4 mt-6 shadow-inner">
        &copy; 2026 Task Manager
    </footer>

</body>
</html>
