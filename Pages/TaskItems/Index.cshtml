@page
@model TaskManager.Pages.TaskItems.IndexModel
@{
    ViewData["Title"] = "Task List";
}

<div class="py-8">

    <!-- Page Header -->
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-4xl font-bold text-gray-800">
                Your Tasks
            </h1>
            <p class="text-gray-500 mt-1">
                Stay organized and manage your workflow efficiently.
            </p>
        </div>

        <a asp-page="./Create"
               class="px-5 py-3 bg-green-500 text-white rounded-xl shadow-md hover:bg-green-400 transition">
            + Create Task
        </a>
    </div>

    <!-- Search Bar -->
    <div class="bg-white rounded-2xl shadow-md p-4 mb-6">
        <form method="get" class="flex gap-3">
            <input type="text"
                   name="SearchTerm"
                   value="@Model.SearchTerm"
                   placeholder="Search tasks..."
                   class="flex-1 px-4 py-3 border rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-400" />

            <button type="submit"
                    class="px-5 py-3 bg-blue-500 text-white rounded-xl hover:bg-blue-400 transition">
                Search
            </button>
        </form>
    </div>

    <!-- Task Table -->
    <div class="bg-white rounded-2xl shadow-lg overflow-hidden">

        <table class="w-full">

            <thead class="bg-gray-100">
                <tr class="text-left text-gray-700">
                    <th class="p-4">Title</th>
                    <th class="p-4">Due Date</th>
                    <th class="p-4">Priority</th>
                    <th class="p-4">Status</th>
                    <th class="p-4">Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model.TaskItems)
                {
                    <tr class="border-t hover:bg-gray-50 transition">

                        <td class="p-4 font-medium text-gray-800">
                            @item.Title
                        </td>

                        <td class="p-4 text-gray-600">
                            @item.DueDate.ToShortDateString()
                        </td>

                        <td class="p-4">
                            <span class="px-3 py-1 bg-amber-100 text-amber-700 rounded-full text-sm">
                                @item.Priority
                            </span>
                        </td>

                        <td class="p-4">

                            @if (item.IsCompleted)
                            {
                                <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm">
                                    Completed
                                </span>
                            }
                            else
                            {
                                <span class="px-3 py-1 bg-red-100 text-red-700 rounded-full text-sm">
                                    Pending
                                </span>
                            }

                        </td>

                        <td class="p-4 flex gap-2 flex-wrap">

                            <button onclick="toggleDescription(@item.Id)"
                                    class="px-3 py-2 bg-purple-500 text-white rounded-lg hover:bg-purple-400 transition">
                                Details
                            </button>

                            <a asp-page="./Edit"
                                   asp-route-id="@item.Id"
                                   class="px-3 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-400 transition">
                                Edit
                            </a>

                            <a asp-page="./Delete"
                                   asp-route-id="@item.Id"
                                   class="px-3 py-2 bg-red-500 text-white rounded-lg hover:bg-red-400 transition">
                                Delete
                            </a>

                        </td>

                    </tr>

                    <!-- Hidden Description Row -->
                    <tr id="desc-@item.Id" class="hidden bg-gray-50">
                        <td colspan="5" class="p-4">

                            <div class="bg-white border rounded-xl p-4 shadow-sm">
                                <span class="font-semibold text-gray-700">
                                    Description:
                                </span>

                                <p class="mt-2 text-gray-600">
                                    @(string.IsNullOrWhiteSpace(item.Description)
                                        ? "No description added."
                                        : item.Description)
                                </p>
                            </div>

                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>


<script>
    function toggleDescription(taskId) {
        const row = document.getElementById("desc-" + taskId);
        row.classList.toggle("hidden");
    }
</script>