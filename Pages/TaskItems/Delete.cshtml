@page "{id:int}"
@model TaskManager.Pages.TaskItems.DeleteModel
@{
    ViewData["Title"] = "Delete Task";
}

<h1>@ViewData["Title"]</h1>
<p>Are you sure you want to delete this task?</p>
<ul>
    <li>Title: @Model.TaskItem.Title</li>
    <li>Due: @Model.TaskItem.DueDate.ToShortDateString()</li>
</ul>
<form method="post">
    <input type="hidden" asp-for="TaskItem.Id" />
    <button type="submit">Delete</button>
    <a asp-page="./Index">Cancel</a>
</form>
