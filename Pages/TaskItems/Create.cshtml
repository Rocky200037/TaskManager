@page
@model TaskManager.Pages.TaskItems.CreateModel
@{
    ViewData["Title"] = "Create Task";
}

<div class="max-w-3xl mx-auto py-10">

    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-4xl font-bold text-gray-800">
            Create New Task
        </h1>
        <p class="text-gray-500 mt-2">
            Add a new task, set priorities, and stay organized.
        </p>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-2xl shadow-lg p-8">

        <form method="post" class="space-y-6">

            <!-- Title -->
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    Title
                </label>

                <input asp-for="TaskItem.Title"
                       class="w-full px-4 py-3 border rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-400" />
            </div>

            <!-- Description -->
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    Description
                </label>

                <textarea asp-for="TaskItem.Description"
                          rows="4"
                          class="w-full px-4 py-3 border rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-400"></textarea>
            </div>

            <!-- Due Date -->
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    Due Date
                </label>

                <input asp-for="TaskItem.DueDate"
                       type="date"
                       class="w-full px-4 py-3 border rounded-xl focus:outline-none focus:ring-2 focus:ring-green-400" />
            </div>

            <!-- Priority -->
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    Priority
                </label>

                <select asp-for="TaskItem.Priority"
                        class="w-full px-4 py-3 border rounded-xl focus:outline-none focus:ring-2 focus:ring-amber-400">

                    <option>Low</option>
                    <option>Medium</option>
                    <option>High</option>

                </select>
            </div>

            <!-- Completed -->
            <div class="flex items-center gap-3">

                <input asp-for="TaskItem.IsCompleted"
                       type="checkbox"
                       class="w-5 h-5" />

                <label class="text-gray-700 font-medium">
                    Mark as completed
                </label>

            </div>

            <!-- Buttons -->
            <div class="flex gap-4 pt-4">

                <button type="submit"
                        class="px-6 py-3 bg-green-500 text-white rounded-xl shadow-md hover:bg-green-400 transition">
                    Create Task
                </button>

                <a asp-page="./Index"
                       class="px-6 py-3 bg-gray-200 text-gray-700 rounded-xl hover:bg-gray-300 transition">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>